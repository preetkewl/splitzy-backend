{
  "name": "splitzy-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend API for Splitzy — split trip expenses among friends.",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "ops:cleanup-tokens": "tsx scripts/cleanup-expired-tokens.ts",
    "smoke:http": "tsx scripts/smoke.ts",
    "smoke:auth": "tsx scripts/auth-smoke.ts",
    "smoke:trip": "tsx scripts/trip-smoke.ts",
    "smoke:engine": "tsx scripts/balance-engine-test.ts",
    "smoke:regression": "tsx scripts/verify-shares.ts",
    "smoke:expense": "tsx scripts/expense-smoke.ts",
    "smoke:friend": "tsx scripts/friend-smoke.ts",
    "smoke:settlement": "tsx scripts/settlement-smoke.ts",
    "smoke:all": "npm run smoke:http && npm run smoke:auth && npm run smoke:trip && npm run smoke:engine && npm run smoke:regression && npm run smoke:expense && npm run smoke:friend && npm run smoke:settlement",
    "prepare": "husky || true",
    "lint:no-paise": "! grep -rn --include='*.ts' '[Pp]aise' src scripts prisma/seed.ts 2>/dev/null || (echo 'ERROR: legacy paise terminology found — rename to minor units' && exit 1)"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^8.0.0",
    "http-status-codes": "^2.3.0",
    "jsonwebtoken": "^9.0.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.9.0",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.31.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "tsc-alias": "^1.8.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
