# Production environment template.
# Copy to `.env.production` (or feed via your secrets manager) and fill in.
# `src/config/env.ts` validates every variable at startup with Zod —
# missing or malformed values exit the process before the listener binds.

# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1

# Build/release identifier. Surfaced by /api/v1/health and /api/v1/health/ready.
# Set via Docker `ARG VERSION=$(git rev-parse --short HEAD)` or your CI pipeline.
SERVICE_VERSION=

# ─── Database ────────────────────────────────────────────────────────────────
# Production: point to a managed Postgres (RDS / Cloud SQL / Neon) or a
# Postgres container behind a private network. Use connection pooling
# (PgBouncer / Prisma Accelerate) for >1 API instance.
#
#   postgresql://user:pass@host:5432/splitzy?schema=public&connection_limit=10
DATABASE_URL=

# ─── Auth — JWT ──────────────────────────────────────────────────────────────
# 64+ random chars. Rotate by adding a new key and supporting both for
# the access-token TTL window — doable later in TokenService without
# changing the API surface.
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Production: never `*`. Comma-separated list of mobile-app origins +
# admin tools. Behind a CDN, set the CDN origin too.
CORS_ORIGINS=https://app.splitzy.example.com

# ─── Rate limiting ───────────────────────────────────────────────────────────
# Defaults. /auth/login + /auth/verify have a stricter per-route limiter
# (10/min) wired in src/middlewares/rate-limit.ts; override per-route
# only if you change the auth surface.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Logging ─────────────────────────────────────────────────────────────────
# Pino emits structured JSON in production (pino-pretty is dev-only).
# Use `info` for normal traffic, `warn` for low-noise environments.
LOG_LEVEL=info

# ─── Future: cache backend ───────────────────────────────────────────────────
# Reserved. The cache layer (src/infrastructure/cache) ships with an
# in-memory backend today. When you scale past one API instance, set
# REDIS_URL and replace the binding in src/infrastructure/cache/index.ts.
# REDIS_URL=

# ─── Firebase Admin (FCM push) ───────────────────────────────────────────────
# Paste the ENTIRE service-account JSON as one value. Optional — if unset,
# notification calls become no-ops (the server still boots).
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Monetization / Google Play (REQUIRED in production) ─────────────────────
# In production, startup FAILS FAST (src/config/startup-validation.ts) if any of
# the three below are missing — a broken billing surface never serves traffic.
# Set MONETIZATION_REQUIRED=false ONLY for a non-billing staging API.
MONETIZATION_REQUIRED=true

# MUST equal the Play Console app id + the Flutter applicationId.
# Wrong value → every purchases.subscriptionsv2.get 404s and verify fails.
GOOGLE_PLAY_PACKAGE_NAME=com.hk.settlio

# Full service-account JSON (single value). The account needs the Play Console
# "View financial data / Manage orders" permission. If unset, verify fails
# CLOSED (never fake-grants).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# Shared secret guarding POST /subscriptions/rtdn. Append to the Pub/Sub push
# endpoint as ?token=… (or send as x-rtdn-token). In production the webhook
# REJECTS any request without a matching token.
RTDN_VERIFICATION_TOKEN=

# ─── Feature flags ───────────────────────────────────────────────────────────
# Enable non-EQUAL split types (EXACT / PERCENT / SHARES). Turn on only once the
# matching frontend build is in production. Old clients are unaffected.
FEATURE_SPLIT_TYPES_ENABLED=true
