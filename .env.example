# ─── Server ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# ─── Database ────────────────────────────────────────────────────────────────
# In Docker compose: postgresql://splitzy:splitzy@postgres:5432/splitzy?schema=public
# In local dev:      postgresql://splitzy:splitzy@localhost:5432/splitzy?schema=public
DATABASE_URL=postgresql://splitzy:splitzy@localhost:5432/splitzy?schema=public

# ─── Auth (used in later steps; reserved here so env validation passes) ──────
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * for any (dev only).
CORS_ORIGINS=*

# ─── Rate limiting ───────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# ─── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Google Play subscription verification (Phase 2B) ────────────────────────
# The Android application id whose subscriptions are verified. MUST match the
# Play Console app id + the Flutter applicationId (com.hk.settlio).
GOOGLE_PLAY_PACKAGE_NAME=com.hk.settlio
# Full service-account JSON (single line or multi-line). Needs the Play Console
# "View financial data / Manage orders" permission. If unset, /subscriptions/verify
# fails closed (it never fake-grants).
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}
# Shared secret guarding POST /subscriptions/rtdn. Append to the Pub/Sub push
# endpoint as ?token=… (or send as x-rtdn-token). Required in production.
# RTDN_VERIFICATION_TOKEN=replace-with-a-long-random-string
