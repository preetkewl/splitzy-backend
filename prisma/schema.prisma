// Splitzy — backend Prisma schema.
//
// Money is stored as INTEGER paise (₹1 = 100 paise). Never use Float/Decimal
// for amounts — the Flutter client sends and renders ints, and SUM aggregates
// must round-trip exactly.
//
// All primary keys are UUIDs (Postgres-native `uuid` via @db.Uuid). UUIDs are
// generated app-side via Prisma's @default(uuid()) so we don't depend on the
// pgcrypto extension being present in every environment.
//
// Soft-delete is opt-in. Tables that hold history users care about
// (User, Trip, Expense) carry `deletedAt`. Pure join/transactional rows
// (TripMember, ExpenseParticipant, FriendRequest, Friendship, Settlement,
// RefreshToken) are hard-deleted or use a status enum.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

enum TripMemberRole {
  OWNER
  MEMBER
}

enum ExpenseCategory {
  STAY
  FOOD
  TRAVEL
  FUN
  MISC
}

/// How an expense's total amount is divided among its participants.
///
/// The split type is an INPUT STRATEGY only. It drives which calculator the
/// service layer invokes to produce per-participant sharePaise values before
/// writing to the database. Once written, the balance engine is completely
/// agnostic to split type — it reads only ExpenseParticipant.sharePaise.
///
/// Adding a new value here requires:
///   1. A dedicated migration file containing ONLY the ALTER TYPE … ADD VALUE
///      statement (enum DDL must never share a file with table DDL).
///   2. A new SplitCalculator implementation in the service layer.
///   3. Updated Zod validation to accept the new type's input shape.
///
/// EQUAL   — Every participant owes floor(amountPaise / n). The payer absorbs
///           the floor-division remainder so SUM(sharePaise) = amountPaise
///           exactly. No metadata columns are populated on
///           ExpenseParticipant; basisPoints / shareUnits / exactAmountPaise
///           are all NULL for these rows.
///
/// EXACT   — Each participant's share is specified by the client in paise.
///           The service validates SUM(exactAmountPaise) = amountPaise before
///           writing. sharePaise equals exactAmountPaise for every row;
///           no rounding is involved.
///
/// PERCENT — Each participant's share is expressed as a percentage in basis
///           points (1 bp = 0.01%). The service validates
///           SUM(basisPoints) = 10 000 and applies the Largest Remainder
///           Method to distribute any paise remainder without losing or
///           gaining a single paise.
///
/// SHARES  — Each participant is assigned a positive integer unit count.
///           sharePaise = floor(shareUnits / totalShareUnits * amountPaise)
///           with the Largest Remainder Method for the remainder. Useful for
///           "I ate twice as much" style splits.
enum ExpenseSplitType {
  EQUAL
  EXACT
  PERCENT
  SHARES
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SettlementMethod {
  UPI
  CASH
  MANUAL
}

enum Platform {
  ANDROID
  IOS
}

// ──────────────────────────────────────────────────────────────────────────────
// User & Auth
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(uuid()) @db.Uuid
  /// Firebase UID from Google Sign-In. Nullable for migration compatibility
  /// with any pre-existing phone-auth rows; all new rows will have this set.
  firebaseUid String? @unique
  email       String? @unique
  /// Optional profile field — not used for authentication.
  phone       String? @unique
  /// Public username without leading "@". Indexed for friend search.
  handle      String  @unique
  name        String
  /// Hex deterministic from id at signup. Stored so the avatar stays
  /// stable if the derivation rule changes later.
  avatarColor String
  avatarUrl   String?
  upiId       String?

  // ── Subscription (Google Play) ───────────────────────────────────────────
  isPremium              Boolean   @default(false)
  /// Raw purchase token from Google Play. Stored for server-side verification.
  subscriptionToken      String?
  /// Product ID purchased (e.g. splitzy_weekly, splitzy_monthly).
  subscriptionProductId  String?
  /// When the current subscription period expires. Null until first purchase.
  subscriptionExpiresAt  DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens          RefreshToken[]
  ownedTrips             Trip[]               @relation("TripCreator")
  memberships            TripMember[]
  expensesPaid           Expense[]            @relation("ExpensePayer")
  expensesCreated        Expense[]            @relation("ExpenseCreator")
  expenseParticipations  ExpenseParticipant[]
  settlementsFrom        Settlement[]         @relation("SettlementFrom")
  settlementsTo          Settlement[]         @relation("SettlementTo")
  settlementsCreated     Settlement[]         @relation("SettlementCreator")
  friendRequestsSent     FriendRequest[]      @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]      @relation("FriendRequestReceiver")
  friendshipsAsA         Friendship[]         @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]         @relation("FriendshipUserB")
  deviceTokens           DeviceToken[]

  @@index([deletedAt])
  @@index([name])
  @@map("users")
}

/// Server-side rotating refresh tokens. Access tokens stay JWT-only.
/// `tokenHash` stores SHA-256(plaintext) — we never persist the raw token.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  /// Optional metadata for session listing / revocation UX.
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────────────────────
// Trips
// ──────────────────────────────────────────────────────────────────────────────

model Trip {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  emoji       String
  /// Hex (e.g. "#EAD9A8"). Picked at creation from a small palette.
  coverColor  String
  /// Optional free-text trip note. Capped at 500 chars at the validation layer.
  description String?
  createdById String  @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy   User         @relation("TripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     TripMember[]
  expenses    Expense[]
  settlements Settlement[]

  @@index([createdById])
  @@index([deletedAt])
  @@map("trips")
}

/// Bridge table for the many-to-many between User and Trip.
/// `role` distinguishes the trip creator from regular members; the schema
/// supports promotion later without a migration.
model TripMember {
  id     String         @id @default(uuid()) @db.Uuid
  tripId String         @db.Uuid
  userId String         @db.Uuid
  role   TripMemberRole @default(MEMBER)

  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

// ──────────────────────────────────────────────────────────────────────────────
// Expenses
// ──────────────────────────────────────────────────────────────────────────────

model Expense {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @db.Uuid
  title       String
  /// ── CANONICAL ACCOUNTING FIELD ────────────────────────────────────────────
  /// Total amount in paise. Always a positive integer. Never a Float or
  /// Decimal. The Flutter client sends and receives integers; SUM aggregates
  /// must round-trip exactly. This is the amount against which
  /// SUM(ExpenseParticipant.sharePaise) must equal for every expense.
  amountPaise Int
  category    ExpenseCategory  @default(MISC)
  /// The strategy used to compute participant shares at creation time.
  /// After the expense is written this field is informational only —
  /// the balance engine never branches on it. See the ExpenseSplitType
  /// enum documentation for the contract each value implies.
  splitType   ExpenseSplitType @default(EQUAL)
  paidById    String           @db.Uuid
  createdById String           @db.Uuid
  /// User-supplied date for the expense (the receipt date), distinct from createdAt.
  spentAt     DateTime

  /// ── AUDIT METADATA ────────────────────────────────────────────────────────
  /// Immutable snapshot of the raw split intent as supplied by the client
  /// at creation time. NULL for historical EQUAL expenses (their split is
  /// fully reconstructible from amountPaise and participant count).
  ///
  /// This field is NEVER read by the balance engine or any accounting code.
  /// It exists solely to allow the UI and support tooling to display or
  /// verify the original user intent without reverse-engineering it from
  /// the computed sharePaise values.
  ///
  /// Shape by split type:
  ///   EQUAL   → null
  ///   EXACT   → { "participants": { "<userId>": <exactPaise: number> } }
  ///   PERCENT → { "participants": { "<userId>": <basisPoints: number> } }
  ///   SHARES  → { "participants": { "<userId>": <shareUnits: number> } }
  ///
  /// Written once at expense creation; never updated thereafter. If the
  /// expense is soft-deleted, splitMeta is retained for audit purposes.
  splitMeta Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  paidBy       User                 @relation("ExpensePayer", fields: [paidById], references: [id], onDelete: Restrict)
  createdBy    User                 @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  participants ExpenseParticipant[]

  @@index([tripId, spentAt(sort: Desc)])
  @@index([paidById])
  @@index([deletedAt])
  @@map("expenses")
}

/// One row per (expense, participant). Records both the canonical accounting
/// value (sharePaise) and optional split-strategy metadata for display/audit.
///
/// ── ACCOUNTING INVARIANT ──────────────────────────────────────────────────
/// SUM(sharePaise) across all rows for a given expenseId MUST equal
/// Expense.amountPaise. This invariant is enforced by the service layer at
/// write time and asserted by the balance engine at read time. No paise may
/// be created or destroyed across the life of an expense.
///
/// ── FIELD RESPONSIBILITIES ───────────────────────────────────────────────
///
/// sharePaise (CANONICAL, mandatory)
///   The final, computed integer amount this participant owes for this
///   expense, in paise. This is the ONLY field the balance engine reads.
///   It is set at creation and never modified (expenses are immutable).
///   Correct for every split type — the split type only affects HOW this
///   value was computed before being written.
///
/// basisPoints (AUDIT, nullable — PERCENT splits only)
///   The percentage share assigned to this participant, expressed in basis
///   points (1 bp = 0.01%). Range: 1–10 000. NULL for all other split types.
///   DB constraint: expense_participants_single_meta_chk ensures at most one
///   metadata column is non-NULL per row.
///   DB constraint: expense_participants_meta_range_chk enforces the range.
///
/// shareUnits (AUDIT, nullable — SHARES splits only)
///   The raw ratio unit for this participant (e.g., if split is 3:5:7, this
///   holds 3, 5, or 7). Range: 1–1 000 000. NULL for all other split types.
///
/// exactAmountPaise (AUDIT, nullable — EXACT splits only)
///   The client-specified exact amount in paise. Range: ≥ 0. For EXACT
///   splits, sharePaise equals this value (no rounding). NULL for all other
///   split types.
///
/// ── HISTORICAL ROWS ──────────────────────────────────────────────────────
/// All rows created before this migration have basisPoints = NULL,
/// shareUnits = NULL, and exactAmountPaise = NULL. This is correct:
/// EQUAL expenses carry no metadata beyond amountPaise and participant count.
model ExpenseParticipant {
  id        String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  userId    String @db.Uuid

  /// ── CANONICAL ACCOUNTING FIELD — read by the balance engine ──────────────
  /// The final computed integer share this participant owes, in paise.
  /// SUM(sharePaise) across all participants for one expense = amountPaise.
  /// Immutable after creation. Never null.
  sharePaise Int

  /// ── SUPPLEMENTARY AUDIT FIELDS — never read by the balance engine ─────────
  /// At most one of these three columns will be non-NULL for any given row.
  /// The DB enforces this with the expense_participants_single_meta_chk
  /// constraint (see migration 20260526100001). NULL means EQUAL split.

  /// PERCENT split only. Participant's percentage share in basis points
  /// (10 000 bp = 100%). Validated by service: SUM(basisPoints) = 10 000.
  /// DB range constraint: [1, 10 000].
  basisPoints Int?

  /// SHARES split only. Raw ratio unit for this participant.
  /// DB range constraint: [1, 1 000 000].
  shareUnits Int?

  /// EXACT split only. Client-specified exact amount in paise.
  /// For EXACT splits, sharePaise == exactAmountPaise (no rounding).
  /// DB range constraint: ≥ 0.
  exactAmountPaise Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

// ──────────────────────────────────────────────────────────────────────────────
// Settlements
// ──────────────────────────────────────────────────────────────────────────────

/// A real, persisted money movement between two trip members. Distinct from
/// the *suggested* greedy transfers, which are computed on-the-fly from
/// expenses + existing settlements. Marking a suggested transfer "paid"
/// inserts a row here with status=COMPLETED.
model Settlement {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @db.Uuid
  fromUserId  String           @db.Uuid
  toUserId    String           @db.Uuid
  amountPaise Int
  status      SettlementStatus @default(COMPLETED)
  method      SettlementMethod @default(UPI)
  note        String?
  /// Provider-supplied reference (e.g. UPI tx id). Free-form; not verified
  /// server-side — reserved for future reconciliation.
  externalRef String?
  /// When the money actually moved (may differ from createdAt if recorded later).
  settledAt   DateTime?
  /// Who recorded the settlement (usually the payer).
  createdById String           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser  User @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tripId, status])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

// ──────────────────────────────────────────────────────────────────────────────
// Friends
// ──────────────────────────────────────────────────────────────────────────────

/// Directional pending request (A → B). Once accepted, a row is moved into
/// `Friendship` and this row's status becomes ACCEPTED (kept for audit).
model FriendRequest {
  id          String              @id @default(uuid()) @db.Uuid
  fromUserId  String              @db.Uuid
  toUserId    String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friend_requests")
}

/// Bidirectional friendship. Stored once with the canonical ordering
/// userAId < userBId (string compare on UUIDs) so we never have duplicate
/// rows representing the same pair.
model Friendship {
  id      String @id @default(uuid()) @db.Uuid
  userAId String @db.Uuid
  userBId String @db.Uuid

  since     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// ──────────────────────────────────────────────────────────────────────────────
// Device Tokens (FCM push notifications)
// ──────────────────────────────────────────────────────────────────────────────

/// One row per registered device. `token` is unique globally — the same
/// physical device always reuses its row via upsert. Index on userId lets
/// `NotificationService` batch-fetch all tokens for a user in one query.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  Platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}
