// Splitzy — backend Prisma schema.
//
// Money is stored as INTEGER minor units (the smallest indivisible unit of the
// expense's currency: cents for USD, paise for INR, yen for JPY, fils for KWD).
// Never use Float/Decimal for amounts — the Flutter client sends and renders ints,
// and SUM aggregates must round-trip exactly.
//
// All primary keys are UUIDs (Postgres-native `uuid` via @db.Uuid). UUIDs are
// generated app-side via Prisma's @default(uuid()) so we don't depend on the
// pgcrypto extension being present in every environment.
//
// Soft-delete is opt-in. Tables that hold history users care about
// (User, Trip, Expense) carry `deletedAt`. Pure join/transactional rows
// (TripMember, ExpenseParticipant, FriendRequest, Friendship, Settlement,
// RefreshToken) are hard-deleted or use a status enum.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────────

enum TripMemberRole {
  OWNER
  MEMBER
}

enum ExpenseCategory {
  STAY
  FOOD
  TRAVEL
  FUN
  MISC
}

/// How an expense's total amount is divided among its participants.
///
/// The split type is an INPUT STRATEGY only. It drives which calculator the
/// service layer invokes to produce per-participant shareMinor values before
/// writing to the database. Once written, the balance engine is completely
/// agnostic to split type — it reads only ExpenseParticipant.shareMinor.
///
/// Adding a new value here requires:
///   1. A dedicated migration file containing ONLY the ALTER TYPE … ADD VALUE
///      statement (enum DDL must never share a file with table DDL).
///   2. A new SplitCalculator implementation in the service layer.
///   3. Updated Zod validation to accept the new type's input shape.
///
/// EQUAL   — Every participant owes floor(amountMinor / n). The payer absorbs
///           the floor-division remainder so SUM(shareMinor) = amountMinor
///           exactly. No metadata columns are populated on
///           ExpenseParticipant; basisPoints / shareUnits / exactAmountMinor
///           are all NULL for these rows.
///
/// EXACT   — Each participant's share is specified by the client in minor units.
///           The service validates SUM(exactAmountMinor) = amountMinor before
///           writing. shareMinor equals exactAmountMinor for every row;
///           no rounding is involved.
///
/// PERCENT — Each participant's share is expressed as a percentage in basis
///           points (1 bp = 0.01%). The service validates
///           SUM(basisPoints) = 10 000 and applies the Largest Remainder
///           Method to distribute any minor-unit remainder without losing or
///           gaining a single unit.
///
/// SHARES  — Each participant is assigned a positive integer unit count.
///           shareMinor = floor(shareUnits / totalShareUnits * amountMinor)
///           with the Largest Remainder Method for the remainder. Useful for
///           "I ate twice as much" style splits.
enum ExpenseSplitType {
  EQUAL
  EXACT
  PERCENT
  SHARES
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum SettlementMethod {
  UPI
  CASH
  MANUAL
}

enum Platform {
  ANDROID
  IOS
}

/// V3 Activity feed event types. Append-only; adding a value requires a
/// dedicated `ALTER TYPE … ADD VALUE` migration (enum DDL must not share a
/// file with table DDL).
enum ActivityType {
  EXPENSE_ADDED
  SETTLEMENT_COMPLETED
  FRIEND_ACCEPTED
  MEMBER_ADDED
  GROUP_CREATED
}

/// The primary subject an activity points at — used for deep-linking
/// (tap → open the entity) and analytics grouping. Distinct from `tripId`,
/// which is the surrounding context.
enum ActivityEntityType {
  EXPENSE
  SETTLEMENT
  TRIP
  USER
}

// ──────────────────────────────────────────────────────────────────────────────
// Monetization (Phase 2A — entitlement foundation)
//
// These power the server-authoritative entitlement model. Nothing here is set
// from client-trusted input: entitlement facts derive from verified purchases
// (verification + RTDN land in later phases). Like every enum in this file,
// adding a value requires a dedicated `ALTER TYPE … ADD VALUE` migration that
// shares no file with table DDL.
// ──────────────────────────────────────────────────────────────────────────────

/// Abstract capability a user can hold. Source-agnostic: PREMIUM can be granted
/// by a subscription today and by a reward/admin grant later. Extensible
/// (e.g. NO_ADS, UNLIMITED_TRIPS) without reshaping the entitlement tables.
enum EntitlementType {
  PREMIUM
}

/// Where an entitlement came from. Only SUBSCRIPTION is exercised in Phase 2A;
/// the rest are reserved so reward/admin/promo flows drop in without migration.
enum EntitlementSource {
  SUBSCRIPTION
  REWARD
  GRANT
  PROMO
}

/// Derived on/off state of a single entitlement row. Distinct from
/// SubscriptionState (the Google billing lifecycle) — many subscription states
/// collapse to the same entitlement answer (e.g. CANCELED-but-in-period and
/// IN_GRACE_PERIOD both keep the entitlement ACTIVE).
enum EntitlementStatus {
  ACTIVE
  EXPIRED
  REVOKED
}

/// Google Play subscription lifecycle, mirrored from the Developer API /
/// `subscriptionsv2` state. PENDING is the local-only initial state before any
/// verification has run (the only state Phase 2A can produce).
enum SubscriptionState {
  PENDING
  ACTIVE
  CANCELED
  IN_GRACE_PERIOD
  ON_HOLD
  PAUSED
  EXPIRED
  REVOKED
}

/// Append-only audit event taxonomy. Records every external signal and every
/// derived state change for reconciliation/forensics. RTDN_* values are
/// reserved for the later webhook phase.
enum AuditEventType {
  VERIFY_REQUESTED
  VERIFY_SUCCEEDED
  VERIFY_FAILED
  PURCHASE_RECORDED
  PURCHASE_UPDATED
  ENTITLEMENT_GRANTED
  ENTITLEMENT_RENEWED
  ENTITLEMENT_REVOKED
  ENTITLEMENT_EXPIRED
  RTDN_RECEIVED
}

/// Origin of an audit signal. Lets us separate client-driven writes from
/// Google-driven (RTDN) ones from internal jobs/admin actions.
enum AuditSource {
  CLIENT
  RTDN
  SYSTEM
  ADMIN
}

/// Business reason behind an entitlement_history transition. BACKFILL marks
/// rows synthesised by the grandfathering migration so they are distinguishable
/// from genuinely-verified grants during later reconciliation.
enum EntitlementChangeReason {
  PURCHASE_VERIFIED
  RENEWAL
  CANCELLATION
  EXPIRY
  REVOCATION
  ADMIN_GRANT
  REWARD_GRANT
  BACKFILL
}

// ──────────────────────────────────────────────────────────────────────────────
// User & Auth
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id          String  @id @default(uuid()) @db.Uuid
  /// Firebase UID from Google Sign-In. Nullable for migration compatibility
  /// with any pre-existing phone-auth rows; all new rows will have this set.
  firebaseUid String? @unique
  email       String? @unique
  /// Optional profile field — not used for authentication.
  phone       String? @unique
  /// Public username without leading "@". Indexed for friend search.
  handle      String  @unique
  name        String
  /// Hex deterministic from id at signup. Stored so the avatar stays
  /// stable if the derivation rule changes later.
  avatarColor String
  avatarUrl   String?
  upiId       String?

  // ── Subscription (Google Play) — LEGACY (Phase 1) ──────────────────────────
  // DEPRECATED as of Phase 2A. These are NO LONGER the source of truth — that
  // role moves to UserEntitlement (derived state) + SubscriptionPurchase (the
  // verified ledger). They are retained only for backward compatibility while
  // the backfill + frontend cutover land, and must not be written from any
  // client-driven path. Slated for removal once enforcement reads entitlements.
  /// @deprecated use the PREMIUM UserEntitlement instead.
  isPremium              Boolean   @default(false)
  /// @deprecated moved to SubscriptionPurchase.purchaseToken (never store the
  /// token on the user row — it enabled token-sharing across accounts).
  subscriptionToken      String?
  /// @deprecated derived from SubscriptionPurchase.productId.
  subscriptionProductId  String?
  /// @deprecated superseded by premiumExpiresAt (cache) / UserEntitlement.
  subscriptionExpiresAt  DateTime?

  /// Denormalized read-cache of the active PREMIUM entitlement's expiry, kept
  /// so `/auth/me` and toUserDto can answer "is premium / until when" with no
  /// extra query. Written ONLY by the entitlement service — never the client.
  /// NULL = no active premium entitlement.
  premiumExpiresAt       DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  refreshTokens          RefreshToken[]
  ownedTrips             Trip[]               @relation("TripCreator")
  memberships            TripMember[]
  expensePayments        ExpensePayment[]
  expensesCreated        Expense[]            @relation("ExpenseCreator")
  expenseParticipations  ExpenseParticipant[]
  settlementsFrom        Settlement[]         @relation("SettlementFrom")
  settlementsTo          Settlement[]         @relation("SettlementTo")
  settlementsCreated     Settlement[]         @relation("SettlementCreator")
  friendRequestsSent     FriendRequest[]      @relation("FriendRequestSender")
  friendRequestsReceived FriendRequest[]      @relation("FriendRequestReceiver")
  friendshipsAsA         Friendship[]         @relation("FriendshipUserA")
  friendshipsAsB         Friendship[]         @relation("FriendshipUserB")
  deviceTokens           DeviceToken[]
  activitiesReceived     Activity[]           @relation("ActivityRecipient")
  activitiesActed        Activity[]           @relation("ActivityActor")
  subscriptionPurchases  SubscriptionPurchase[]
  entitlements           UserEntitlement[]
  quotaTracking          QuotaTracking[]
  rewardUnlocks          RewardUnlock[]

  @@index([deletedAt])
  @@index([name])
  @@map("users")
}

/// Server-side rotating refresh tokens. Access tokens stay JWT-only.
/// `tokenHash` stores SHA-256(plaintext) — we never persist the raw token.
model RefreshToken {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  /// Optional metadata for session listing / revocation UX.
  userAgent  String?
  ipAddress  String?
  expiresAt  DateTime
  revokedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

// ──────────────────────────────────────────────────────────────────────────────
// Trips
// ──────────────────────────────────────────────────────────────────────────────

model Trip {
  id          String  @id @default(uuid()) @db.Uuid
  name        String
  emoji       String
  /// Hex (e.g. "#EAD9A8"). Picked at creation from a small palette.
  coverColor  String
  /// Optional free-text trip note. Capped at 500 chars at the validation layer.
  description String?
  createdById String  @db.Uuid

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  createdBy   User         @relation("TripCreator", fields: [createdById], references: [id], onDelete: Restrict)
  members     TripMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  Activity[]

  @@index([createdById])
  @@index([deletedAt])
  @@map("trips")
}

/// Bridge table for the many-to-many between User and Trip.
/// `role` distinguishes the trip creator from regular members; the schema
/// supports promotion later without a migration.
model TripMember {
  id     String         @id @default(uuid()) @db.Uuid
  tripId String         @db.Uuid
  userId String         @db.Uuid
  role   TripMemberRole @default(MEMBER)

  joinedAt  DateTime  @default(now())
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([tripId, userId])
  @@index([userId])
  @@map("trip_members")
}

// ──────────────────────────────────────────────────────────────────────────────
// Expenses
// ──────────────────────────────────────────────────────────────────────────────

model Expense {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @db.Uuid
  title       String
  /// ── CANONICAL ACCOUNTING FIELD ────────────────────────────────────────────
  /// Total amount in minor units (the smallest indivisible unit of the
  /// currency: cents for USD, paise for INR, yen for JPY). Always a positive
  /// integer. Never a Float or Decimal. The Flutter client sends and receives
  /// integers; SUM aggregates must round-trip exactly. This is the amount
  /// against which SUM(ExpenseParticipant.shareMinor) must equal for every
  /// expense.
  amountMinor Int
  category    ExpenseCategory  @default(MISC)
  /// The strategy used to compute participant shares at creation time.
  /// After the expense is written this field is informational only —
  /// the balance engine never branches on it. See the ExpenseSplitType
  /// enum documentation for the contract each value implies.
  splitType   ExpenseSplitType @default(EQUAL)
  createdById String           @db.Uuid
  /// User-supplied date for the expense (the receipt date), distinct from createdAt.
  spentAt     DateTime

  /// ── AUDIT METADATA ────────────────────────────────────────────────────────
  /// Immutable snapshot of the raw split intent as supplied by the client
  /// at creation time. NULL for historical EQUAL expenses (their split is
  /// fully reconstructible from amountMinor and participant count).
  ///
  /// This field is NEVER read by the balance engine or any accounting code.
  /// It exists solely to allow the UI and support tooling to display or
  /// verify the original user intent without reverse-engineering it from
  /// the computed shareMinor values.
  ///
  /// Shape by split type:
  ///   EQUAL   → null
  ///   EXACT   → { "participants": { "<userId>": <exactAmountMinor: number> } }
  ///   PERCENT → { "participants": { "<userId>": <basisPoints: number> } }
  ///   SHARES  → { "participants": { "<userId>": <shareUnits: number> } }
  ///
  /// Written once at expense creation; never updated thereafter. If the
  /// expense is soft-deleted, splitMeta is retained for audit purposes.
  splitMeta Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  trip         Trip                 @relation(fields: [tripId], references: [id], onDelete: Cascade)
  createdBy    User                 @relation("ExpenseCreator", fields: [createdById], references: [id], onDelete: Restrict)
  payments     ExpensePayment[]
  participants ExpenseParticipant[]

  @@index([tripId, spentAt(sort: Desc)])
  @@index([deletedAt])
  @@map("expenses")
}

/// One row per (expense, participant). Records both the canonical accounting
/// value (shareMinor) and optional split-strategy metadata for display/audit.
///
/// ── ACCOUNTING INVARIANT ──────────────────────────────────────────────────
/// SUM(shareMinor) across all rows for a given expenseId MUST equal
/// Expense.amountMinor. This invariant is enforced by the service layer at
/// write time and asserted by the balance engine at read time. No minor unit
/// may be created or destroyed across the life of an expense.
///
/// ── FIELD RESPONSIBILITIES ───────────────────────────────────────────────
///
/// shareMinor (CANONICAL, mandatory)
///   The final, computed integer amount this participant owes for this
///   expense, in minor units. This is the ONLY field the balance engine reads.
///   It is set at creation and never modified (expenses are immutable).
///   Correct for every split type — the split type only affects HOW this
///   value was computed before being written.
///
/// basisPoints (AUDIT, nullable — PERCENT splits only)
///   The percentage share assigned to this participant, expressed in basis
///   points (1 bp = 0.01%). Range: 1–10 000. NULL for all other split types.
///   DB constraint: expense_participants_single_meta_chk ensures at most one
///   metadata column is non-NULL per row.
///   DB constraint: expense_participants_meta_range_chk enforces the range.
///
/// shareUnits (AUDIT, nullable — SHARES splits only)
///   The raw ratio unit for this participant (e.g., if split is 3:5:7, this
///   holds 3, 5, or 7). Range: 1–1 000 000. NULL for all other split types.
///
/// exactAmountMinor (AUDIT, nullable — EXACT splits only)
///   The client-specified exact amount in minor units. Range: ≥ 0. For EXACT
///   splits, shareMinor equals this value (no rounding). NULL for all other
///   split types.
///
/// ── HISTORICAL ROWS ──────────────────────────────────────────────────────
/// All rows created before this migration have basisPoints = NULL,
/// shareUnits = NULL, and exactAmountMinor = NULL. This is correct:
/// EQUAL expenses carry no metadata beyond amountMinor and participant count.
model ExpenseParticipant {
  id        String @id @default(uuid()) @db.Uuid
  expenseId String @db.Uuid
  userId    String @db.Uuid

  /// ── CANONICAL ACCOUNTING FIELD — read by the balance engine ──────────────
  /// The final computed integer share this participant owes, in minor units.
  /// SUM(shareMinor) across all participants for one expense = amountMinor.
  /// Immutable after creation. Never null.
  shareMinor Int

  /// ── SUPPLEMENTARY AUDIT FIELDS — never read by the balance engine ─────────
  /// At most one of these three columns will be non-NULL for any given row.
  /// The DB enforces this with the expense_participants_single_meta_chk
  /// constraint (see migration 20260526100001). NULL means EQUAL split.

  /// PERCENT split only. Participant's percentage share in basis points
  /// (10 000 bp = 100%). Validated by service: SUM(basisPoints) = 10 000.
  /// DB range constraint: [1, 10 000].
  basisPoints Int?

  /// SHARES split only. Raw ratio unit for this participant.
  /// DB range constraint: [1, 1 000 000].
  shareUnits Int?

  /// EXACT split only. Client-specified exact amount in minor units.
  /// For EXACT splits, shareMinor == exactAmountMinor (no rounding).
  /// DB range constraint: ≥ 0.
  exactAmountMinor Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([userId])
  @@map("expense_participants")
}

/// One row per payer per expense — the PAYMENT dimension of expense accounting.
///
/// ── TWO-DIMENSION ACCOUNTING MODEL ───────────────────────────────────────────
///
/// Every expense has two independent accounting dimensions:
///
///   PAYMENT (this table)     — who contributed money and how much.
///   OBLIGATION (ExpenseParticipant) — who owes money and how much.
///
/// Both dimensions must independently satisfy the same invariant:
///   SUM(contributionMinor) over payments for one expense = Expense.amountMinor
///   SUM(shareMinor) over participants for one expense    = Expense.amountMinor
///
/// These invariants are enforced by the service at write time and asserted by
/// the balance engine at read time. No minor unit may be created or destroyed.
///
/// ── PAYMENT DIM: FIELD RESPONSIBILITIES ──────────────────────────────────────
///
/// contributionMinor (CANONICAL, mandatory, > 0)
///   The integer amount this payer contributed toward this expense, in minor
///   units. Must be positive (DB-level check constraint). Written once at
///   creation; never modified (expenses are immutable).
///
/// paymentMeta (AUDIT, nullable)
///   Optional immutable snapshot for audit and display purposes only.
///   Intended shape (reserved for Phase 3+):
///     { method: "UPI" | "CASH" | …, ref: string | null }
///   Never read by the balance engine. NULL is the current default.
///
/// ── CURRENT USAGE (Phase 2 — single-payer API) ───────────────────────────────
/// The create-expense API still accepts a single `paidByUserId`. The service
/// maps that to exactly one row here with contributionMinor = amountMinor.
/// Multi-payer creation will be unlocked in Phase 3 (payment editor UX).
///
/// ── CASCADE BEHAVIOUR ────────────────────────────────────────────────────────
/// onDelete: Cascade from Expense — deleting (soft or hard) the parent expense
/// removes all its payment rows. The accounting invariant cannot be violated
/// by a partial delete because payments have no independent existence.
model ExpensePayment {
  id                String @id @default(uuid()) @db.Uuid
  expenseId         String @db.Uuid
  userId            String @db.Uuid

  /// ── CANONICAL ACCOUNTING FIELD ────────────────────────────────────────────
  /// Amount this payer contributed toward this expense, in minor units.
  /// Must be a positive integer. DB check constraint enforces > 0.
  /// SUM(contributionMinor) across all rows for a given expenseId MUST equal
  /// Expense.amountMinor.
  contributionMinor Int

  /// ── AUDIT METADATA (optional) ─────────────────────────────────────────────
  /// Immutable snapshot of payment method / reference for audit and display.
  /// Reserved for future use; NULL is the default until Phase 3.
  paymentMeta Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([expenseId, userId])
  @@index([expenseId])
  @@index([userId])
  @@map("expense_payments")
}

// ──────────────────────────────────────────────────────────────────────────────
// Settlements
// ──────────────────────────────────────────────────────────────────────────────

/// A real, persisted money movement between two trip members. Distinct from
/// the *suggested* greedy transfers, which are computed on-the-fly from
/// expenses + existing settlements. Marking a suggested transfer "paid"
/// inserts a row here with status=COMPLETED.
model Settlement {
  id          String           @id @default(uuid()) @db.Uuid
  tripId      String           @db.Uuid
  fromUserId  String           @db.Uuid
  toUserId    String           @db.Uuid
  amountMinor Int
  status      SettlementStatus @default(COMPLETED)
  method      SettlementMethod @default(UPI)
  note        String?
  /// Provider-supplied reference (e.g. UPI tx id). Free-form; not verified
  /// server-side — reserved for future reconciliation.
  externalRef String?
  /// When the money actually moved (may differ from createdAt if recorded later).
  settledAt   DateTime?
  /// Who recorded the settlement (usually the payer).
  createdById String           @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  trip      Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)
  fromUser  User @relation("SettlementFrom", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser    User @relation("SettlementTo", fields: [toUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("SettlementCreator", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([tripId, status])
  @@index([fromUserId])
  @@index([toUserId])
  @@map("settlements")
}

// ──────────────────────────────────────────────────────────────────────────────
// Friends
// ──────────────────────────────────────────────────────────────────────────────

/// Directional pending request (A → B). Once accepted, a row is moved into
/// `Friendship` and this row's status becomes ACCEPTED (kept for audit).
model FriendRequest {
  id          String              @id @default(uuid()) @db.Uuid
  fromUserId  String              @db.Uuid
  toUserId    String              @db.Uuid
  status      FriendRequestStatus @default(PENDING)
  message     String?
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fromUser User @relation("FriendRequestSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User @relation("FriendRequestReceiver", fields: [toUserId], references: [id], onDelete: Cascade)

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("friend_requests")
}

/// Bidirectional friendship. Stored once with the canonical ordering
/// userAId < userBId (string compare on UUIDs) so we never have duplicate
/// rows representing the same pair.
model Friendship {
  id      String @id @default(uuid()) @db.Uuid
  userAId String @db.Uuid
  userBId String @db.Uuid

  since     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userA User @relation("FriendshipUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipUserB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userBId])
  @@map("friendships")
}

// ──────────────────────────────────────────────────────────────────────────────
// Device Tokens (FCM push notifications)
// ──────────────────────────────────────────────────────────────────────────────

/// One row per registered device. `token` is unique globally — the same
/// physical device always reuses its row via upsert. Index on userId lets
/// `NotificationService` batch-fetch all tokens for a user in one query.
model DeviceToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @db.Uuid
  token     String   @unique
  platform  Platform

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("device_tokens")
}

// ──────────────────────────────────────────────────────────────────────────────
// Activity feed (V3)
// ──────────────────────────────────────────────────────────────────────────────

/// Append-only, fan-out-on-write activity feed. ONE row per (recipient, event):
/// an event seen by N users writes N rows. The actor is included as a recipient
/// so the feed doubles as a personal history ("You added Dinner in Goa Trip").
///
/// ── DESIGN CONTRACT ────────────────────────────────────────────────────────
///   - Immutable: rows are only ever inserted (no updates, no soft-delete).
///     The only deletions are FK cascades when the recipient/actor/trip is
///     hard-deleted.
///   - `metadata` is a denormalized render snapshot (actor name, trip name,
///     amount, title, …). The feed renders with ZERO joins and stays correct
///     even if the source row is later edited or soft-deleted.
///   - `entityType` + `entityId` are the deep-link/analytics target (the
///     subject), kept OUTSIDE metadata as typed columns. `tripId` is context.
///   - Writes are fire-and-forget from the business services (best-effort,
///     never blocks or fails the parent write). Not an accounting ledger.
///
/// See migration 20260605100000_add_activity for the table DDL + index.
model Activity {
  id         String             @id @default(uuid()) @db.Uuid
  /// Recipient — whose feed this row belongs to (the fan-out target).
  userId     String             @db.Uuid
  /// Actor — who performed the action. May equal `userId` (own-action rows).
  actorId    String             @db.Uuid
  type       ActivityType
  /// Deep-link subject. `entityId` is nullable only for forward-compatibility;
  /// all five current event types populate it.
  entityType ActivityEntityType
  entityId   String?            @db.Uuid
  /// Surrounding trip context. NULL for FRIEND_ACCEPTED.
  tripId     String?            @db.Uuid
  /// Denormalized render snapshot. See per-type shape in the activity service.
  metadata   Json
  createdAt  DateTime           @default(now())

  user  User  @relation("ActivityRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor User  @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Cascade)
  trip  Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  // The single index that serves the entire feed query: filter by recipient,
  // sort reverse-chronologically, keyset-paginate on (createdAt, id).
  @@index([userId, createdAt(sort: Desc), id])
  // Keeps trip hard-delete cascade from sequential-scanning this table.
  @@index([tripId])
  @@map("activities")
}

// ──────────────────────────────────────────────────────────────────────────────
// Monetization — entitlement foundation (Phase 2A)
// ──────────────────────────────────────────────────────────────────────────────

/// The purchase ledger: one row per Google Play purchase token, holding the
/// latest known billing state. Facts here are append-safe — the row is updated
/// in place across the subscription lifetime (renewals/cancellations), never
/// duplicated. Verification + RTDN that populate the Google-sourced fields land
/// in later phases; in Phase 2A a row is created PENDING with the local token.
model SubscriptionPurchase {
  id                  String            @id @default(uuid()) @db.Uuid
  userId              String            @db.Uuid
  /// Globally-unique Play purchase token. THE replay/sharing guard: one token →
  /// one row → bound to the first claiming user. A second user presenting the
  /// same token is rejected by the service, never granted a second time.
  purchaseToken       String            @unique
  /// Product purchased (e.g. settlio_premium_monthly). In later phases this is
  /// authoritatively the productId Google returns, not the client's claim.
  productId           String
  /// Google orderId (latest known). NULL until first verification.
  orderId             String?
  state               SubscriptionState @default(PENDING)
  /// Lifecycle timestamps mirrored from Google. NULL until verified.
  purchasedAt         DateTime?
  expiresAt           DateTime?
  autoRenewing        Boolean           @default(false)
  /// Whether the purchase has been acknowledged to Google (must happen within
  /// 3 days or Google auto-refunds). Wired in the verification phase.
  acknowledged        Boolean           @default(false)
  /// Google linkedPurchaseToken — the token chain across upgrades / downgrades /
  /// resubscribes. Lets a renewal/upgrade close the prior purchase's entitlement.
  linkedPurchaseToken String?
  /// Raw latest `subscriptionsv2.get` payload — forensic snapshot for disputes
  /// and reconciliation. NULL in Phase 2A (no verification yet).
  latestGoogleState   Json?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  // Serves the future expiry/renewal sweep: scan due rows by state + expiry.
  @@index([state, expiresAt])
  @@index([orderId])
  @@map("subscription_purchases")
}

/// Derived current entitlement state — the SINGLE read path enforcement will
/// use. A user "has PREMIUM" iff a row exists with status ACTIVE and
/// (expiresAt IS NULL OR expiresAt > now()). Source-aware so the same PREMIUM
/// entitlement can be backed by a subscription today and a reward/grant later.
model UserEntitlement {
  id          String            @id @default(uuid()) @db.Uuid
  userId      String            @db.Uuid
  entitlement EntitlementType
  source      EntitlementSource
  /// Identifier of the granting record within its source domain
  /// (SubscriptionPurchase.id, RewardUnlock.id, an admin-grant id, …). NULL is
  /// allowed for sourceless system grants.
  sourceRef   String?
  status      EntitlementStatus @default(ACTIVE)
  startsAt    DateTime          @default(now())
  /// NULL = perpetual (admin/promo grants). For subscriptions this mirrors the
  /// purchase expiry and is what enforcement compares against now().
  expiresAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Idempotency: re-verifying the same source grant UPDATES the one row rather
  // than inserting a duplicate. (Postgres treats NULL sourceRefs as distinct,
  // which is the intended behaviour for one-off sourceless grants.)
  @@unique([userId, entitlement, source, sourceRef])
  // Hot read path: "does user X hold entitlement Y right now".
  @@index([userId, entitlement, status])
  // Future expiry sweep.
  @@index([status, expiresAt])
  @@map("user_entitlements")
}

/// Append-only forensic log of every monetization signal — verify requests,
/// derived state changes, and (later) each RTDN message. Deliberately has NO
/// foreign key to users: it must survive account deletion as a financial /
/// dispute record. `googleMessageId` is the RTDN idempotency key.
model PurchaseAuditLog {
  id              String         @id @default(uuid()) @db.Uuid
  /// Loose reference (no FK) — NULL when an event can't be resolved to a user
  /// (e.g. a malformed RTDN message).
  userId          String?        @db.Uuid
  purchaseToken   String?
  eventType       AuditEventType
  source          AuditSource    @default(SYSTEM)
  /// Raw event payload (verify body, RTDN message envelope, derived diff, …).
  payload         Json?
  /// Pub/Sub messageId — unique so a redelivered RTDN is dropped idempotently.
  /// NULL for non-RTDN events (NULLs are distinct, so many are allowed).
  googleMessageId String?        @unique
  processedOk     Boolean        @default(true)
  createdAt       DateTime       @default(now())

  @@index([purchaseToken])
  @@index([userId])
  @@index([createdAt])
  @@map("purchase_audit_log")
}

/// Append-only BUSINESS timeline of entitlement on/off transitions — distinct
/// from the raw audit log. Answers "when did premium turn on/off and why" for
/// support and disputes. No FK, for the same survive-deletion reason.
model EntitlementHistory {
  id                String                  @id @default(uuid()) @db.Uuid
  userId            String                  @db.Uuid
  entitlement       EntitlementType
  /// NULL when the entitlement is first created (no prior state).
  fromStatus        EntitlementStatus?
  toStatus          EntitlementStatus
  reason            EntitlementChangeReason
  effectiveAt       DateTime                @default(now())
  /// SubscriptionPurchase.id that drove the change, when applicable.
  relatedPurchaseId String?                 @db.Uuid
  createdAt         DateTime                @default(now())

  @@index([userId, entitlement])
  @@index([createdAt])
  @@map("entitlement_history")
}

/// FUTURE-READY STUB (Phase 2A defines the shape; nothing writes here yet).
/// Server-side counters for metered free-tier limits (e.g. trips_active) so
/// quota enforcement can be authoritative rather than client-side.
model QuotaTracking {
  id            String    @id @default(uuid()) @db.Uuid
  userId        String    @db.Uuid
  /// App-defined counter key, e.g. 'trips_active'.
  quotaKey      String
  usedCount     Int       @default(0)
  /// Per-user override of the default free-tier limit (NULL = use default).
  limitOverride Int?
  /// NULL = lifetime / non-windowed quota; set for periodic (e.g. monthly) ones.
  periodStart   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, quotaKey, periodStart])
  @@map("quota_tracking")
}

/// FUTURE-READY STUB (shape only in Phase 2A). Ad-watch / referral unlocks that
/// later materialise as REWARD-sourced UserEntitlement rows (e.g. +1 trip).
model RewardUnlock {
  id                 String          @id @default(uuid()) @db.Uuid
  userId             String          @db.Uuid
  rewardType         String
  grantedEntitlement EntitlementType
  quantity           Int             @default(1)
  expiresAt          DateTime?
  consumedAt         DateTime?
  sourceEvent        Json?
  createdAt          DateTime        @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, rewardType])
  @@map("reward_unlocks")
}
